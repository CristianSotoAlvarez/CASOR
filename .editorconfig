root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml,axaml,xaml}]
indent_size = 2

[*.cs]
# El dinero SIEMPRE en decimal: prohibido float/double para montos
dotnet_diagnostic.CA1305.severity = warning
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = true
